# ─────────────────────────────────────────────────────────────────
# C-Arm Master — Backend Environment Template
# Copia este archivo a `.env` y asigna tus valores reales.
# El archivo `.env` está en .gitignore y NUNCA debe subirse a Git.
# ─────────────────────────────────────────────────────────────────

# Entorno: 'development' o 'production'
NODE_ENV=development

# Puerto del backend API (por defecto 5000 para evitar colisión con Next.js en 3000)
PORT=5000

# Secreto JWT para firma criptográfica de tokens (mínimo 32 caracteres seguros)
JWT_SECRET=your_jwt_secret_key_here

# Orígenes permitidos para CORS (separados por coma si son varios)
# Local: http://localhost:3000
# Producción: https://tu-dominio-frontend.com,https://admin.tu-dominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Base de datos: Si no se define, se usa SQLite local (database.sqlite)
# Para producción en la nube, define la URL de conexión a PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/carm_master?sslmode=require

# Credenciales iniciales para el script de seed de administrador (npm run seed)
ADMIN_NAME="Super Administrador"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_admin_password_here"

# Secret para proteger el endpoint /api/test-reset en entornos no-prod (tests E2E Playwright)
# El helper de tests debe enviarlo en el header `x-test-secret`. NO usar en producción.
TEST_RESET_SECRET=test-reset-secret-local
