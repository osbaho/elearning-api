# ─────────────────────────────────────────────────────────────────
# C-Arm Master — Backend Environment Template
# Copia este archivo a `.env` y asigna tus valores reales.
# El archivo `.env` está en .gitignore y NUNCA debe subirse a Git.
# ─────────────────────────────────────────────────────────────────

# Entorno: 'development' o 'production'
NODE_ENV=development

# Puerto del backend API (por defecto 5000 para evitar colisión con Next.js en 3000)
PORT=5000

# Secreto JWT para firma criptográfica de tokens (mínimo 32 caracteres seguros).
# El frontend (client/.env.local o el servicio frontend en Docker) necesita EXACTAMENTE el mismo valor:
# src/proxy.js lo usa para validar la sesión de /course, /admin y /onboarding.
JWT_SECRET=your_jwt_secret_key_here

# Orígenes permitidos para CORS (separados por coma si son varios)
# Local: http://localhost:3000
# Producción: https://tu-dominio-frontend.com,https://admin.tu-dominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Detrás de un proxy inverso (nginx, balanceador, gateway de Docker): número de saltos de confianza,
# para que el rate limit vea la IP real del cliente y no la del proxy
# TRUST_PROXY=1

# Base de datos: Si no se define, se usa SQLite local (database.sqlite)
# Para producción en la nube, define la URL de conexión a PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/carm_master?sslmode=require
# SSL hacia PostgreSQL cuando la URL no trae sslmode: disable | require | no-verify (por defecto)
# DATABASE_SSL=require
# Otro archivo SQLite (p. ej. una base desechable para pruebas); por defecto ./database.sqlite
# SQLITE_PATH=./database.sqlite

# URL pública del frontend: los enlaces de los correos (activar cuenta, restablecer contraseña,
# ingresar) apuntan aquí. En producción, el dominio real (https://cursos.midominio.com).
APP_PUBLIC_URL=http://localhost:3000
# Zona horaria de las fechas de acceso de las promociones (inicio y cierre)
# APP_TIMEZONE=America/Bogota

# Correo saliente por SMTP (cualquier proveedor: Amazon SES, Brevo, Postmark, Microsoft 365...).
# Sin SMTP_HOST los correos no salen: quedan en la bitácora como "simulated".
# SMTP_HOST=smtp.proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario_smtp
# SMTP_PASS=contraseña_smtp
# MAIL_FROM="C-Arm Master <no-reply@midominio.com>"

# Retención de exam_logs (eventos del examen y proctoring, evidencia para auditorías).
# Sin definir o 0: se conservan siempre. Con un número de días, al arrancar se borran los más antiguos.
# EXAM_LOG_RETENTION_DAYS=0

# Credenciales iniciales para el script de seed de administrador (npm run seed)
ADMIN_NAME="Super Administrador"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_admin_password_here"

# Secret para proteger el endpoint /api/test-reset en entornos no-prod (tests E2E Playwright)
# El helper de tests debe enviarlo en el header `x-test-secret`. NO usar en producción.
TEST_RESET_SECRET=test-reset-secret-local
