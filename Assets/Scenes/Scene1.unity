MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 13797820}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ed7a2d2b0e2b414e88f72575ff3a865, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CArmSimulator.Minigames.IsocenterCommand.IsocenterCommandController
  config: {fileID: 0}
  defaultTimeLimit: 300
  autoStartOnAwake: 0
  fractureCases:
  - fractureName: "Caso 1: Centrado e Isocentro en Fractura de F\xE9mur"
    clinicalContext: "Traslaci\xF3n longitudinal hacia cef\xE1lico para alinear el isocentro antes de rotar 90\xB0 de AP a lateral."
    requiredOrders:
    - requiredMovement: 0
      requiredDirection: 0
      requiredMagnitude: 5
      rationale: "Avanza cinco cent\xEDmetros hacia cef\xE1lico para centrar la fractura en el isocentro."
    trapSectionTitle: 'FRASES COLOQUIALES (AMBIGUAS - TRAMPA):'
    isTrapWarningExplicit: 1
    caseAmbiguousOrders:
    - orderText: "Un poquito m\xE1s all\xE1"
      pedagogicalFeedback: "Orden ambigua rechazada. Expresiones como \xABun poquito m\xE1s all\xE1\xBB carecen de magnitud en cent\xEDmetros o direcci\xF3n anat\xF3mica. Genera disparos a ciegas y p\xE9rdida de tiempo quir\xFArgico."
    - orderText: Sube un pelo
      pedagogicalFeedback: "Orden coloquial rechazada. \xABSube un pelo\xBB no es una unidad de medida quir\xFArgica. El t\xE9cnico no sabe si mover 1 mm o 5 cm, duplicando la radiaci\xF3n innecesariamente."
    - orderText: "G\xEDralo hacia m\xED"
      pedagogicalFeedback: "Referencia relativa rechazada. Decir \xABhacia m\xED\xBB depende de la posici\xF3n f\xEDsica del cirujano. La orden debe darse en t\xE9rminos del paciente: cef\xE1lico, caudal, AP o lateral."
  - fractureName: 'Caso 2: Despeje Articular de Cadera/Hombro'
    clinicalContext: "Uso de angulaci\xF3n cef\xE1lica de 15\xB0 para despejar la interl\xEDnea articular superpuesta sin magnificaci\xF3n."
    requiredOrders:
    - requiredMovement: 4
      requiredDirection: 0
      requiredMagnitude: 15
      rationale: "Angulaci\xF3n cef\xE1lica de 15 grados para despejar la articulaci\xF3n sin magnificaci\xF3n."
    trapSectionTitle: 'COMANDOS VERBALES ALTERNATIVOS:'
    isTrapWarningExplicit: 0
    caseAmbiguousOrders:
    - orderText: "Mueve un poco a cef\xE1lico"
      pedagogicalFeedback: "Falta de precisi\xF3n m\xE9trica. Aunque indicaste 'a cef\xE1lico', la magnitud 'un poco' es subjetiva. En articulaciones milim\xE9tricas se requiere especificar los grados exactos (15\xB0)."
    - orderText: "Incl\xEDnalo al ojo del cirujano"
      pedagogicalFeedback: "Maniobra no calibrada rechazada. 'Al ojo' no permite reproducir proyecciones estandarizadas ni registrar la t\xE9cnica fluorosc\xF3pica. Especifica angulaci\xF3n y grados."
    - orderText: "G\xEDralo tantito hacia arriba"
      pedagogicalFeedback: "Terminolog\xEDa confusa. 'Girar hacia arriba' confunde rotaci\xF3n orbital con angulaci\xF3n o elevaci\xF3n. Usa la terminolog\xEDa estandarizada del Arco en C."
  - fractureName: "Caso 3: Proyecci\xF3n Oblicua de Pelvis (Judet)"
    clinicalContext: "Paciente politraumatizado con fractura acetabular. Requiere proyecci\xF3n oblicua a 30\xB0 de AP a lateral para evaluar la columna anterior."
    requiredOrders:
    - requiredMovement: 3
      requiredDirection: 6
      requiredMagnitude: 30
      rationale: "Rotaci\xF3n orbital de 30 grados de AP a lateral para despejar la columna anterior del acet\xE1bulo (proyecci\xF3n oblicua de Judet)."
    trapSectionTitle: "COMANDOS T\xC9CNICOS R\xC1PIDOS:"
    isTrapWarningExplicit: 0
    caseAmbiguousOrders:
    - orderText: Rotar a oblicua sin isocentro
      pedagogicalFeedback: "\xA1Grave error geom\xE9trico! Si rotas a oblicua sin haber fijado el isocentro en la pelvis, la cabeza femoral y el acet\xE1bulo se saldr\xE1n completamente de la pantalla al girar."
    - orderText: Disparo continuo mientras gira
      pedagogicalFeedback: "\xA1Violaci\xF3n severa de radioprotecci\xF3n (ALARA)! El disparo continuo en movimiento expone al equipo quir\xFArgico a altas dosis de dispersi\xF3n Compton. Posiciona primero y luego pulsa un disparo corto."
    - orderText: Girar al tope con la mesa
      pedagogicalFeedback: "\xA1Riesgo cr\xEDtico de colisi\xF3n y pellizco! Girar 'hasta hacer tope' con la mesa quir\xFArgica o el paciente puede provocar atrapamiento mec\xE1nico. Debes ordenar exactamente 30\xB0."
  arcTransform: {fileID: 15130858}
  fractureTarget: {fileID: 1352125123}
  xrayMonitorPlane: {fileID: 0}
